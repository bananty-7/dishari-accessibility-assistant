# Optional. Run uvicorn with --env-file .env to load these.
API_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
YOLO_MODEL_PATH=models/yolo11n.pt
# Leave empty for a YOLO object list instead of a full scene description.
OLLAMA_VISION_MODEL=
OLLAMA_URL=http://localhost:11434
# Choose local for YOLO/Ollama, gemini for online scene descriptions.
SCENE_PROVIDER=local
# Used only when SCENE_PROVIDER=gemini. Keep your real key in .env, never in GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
